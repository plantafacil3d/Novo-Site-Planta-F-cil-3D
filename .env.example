# Público (vai para o bundle): nunca coloque segredos em NEXT_PUBLIC_*
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Opcional: troca o WhatsApp padrão do site (só dígitos com DDI e DDD, ex.: 5599999999999).
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Supabase: Project URL e chave pública (sb_publishable_...). Painel > Project Settings > API.
# Nunca coloque aqui a service_role / secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
